@startuml AlocacaoProvas
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum TipoUsuario {
  ALUNO
  FISCAL
  ADMIN
}

enum StatusSala {
  LIVRE
  OCUPADA
  MANUTENCAO
}

class Usuario {
  - id : int
  - nome : String
  - email : String
  - senha : String
  - tipo : TipoUsuario
  + cadastrar()
  + autenticar()
}

class Aluno {
  - matricula : String
  + consultarAlocacao()
}

class Fiscal {
  - codigoFuncionario : String
  + consultarSalaDesignada()
}

class Administrador {
  + gerenciarSalas()
  + gerenciarProvas()
  + executarAlocacao()
}

class Curso {
  - id : int
  - codigo : String
  - nome : String
}

class Filial {
  - id : int
  - nome : String
  - endereco : String
  + listarSalasVazias(dataHora) : List<Sala>
}

class Sala {
  - id : int
  - numero : String
  - capacidade : int
  - status : StatusSala
  + estaDisponivel(dataHora) : bool
  + ocupar()
  + liberar()
}

class Prova {
  - id : int
  - disciplina : String
  - dataHora : DateTime
  - duracaoMin : int
}

class Alocacao {
  - id : int
  - dataAlocacao : DateTime
  + validarCapacidade() : bool
  + adicionarAluno(aluno : Aluno)
  + definirFiscal(fiscal : Fiscal)
}

class GerenciadorAlocacao {
  + buscarSalasVazias(filial, prova) : List<Sala>
  + alocarAlunosPorCursoEFilial(prova)
  + alocarFiscal(sala, prova)
}

Usuario <|-- Aluno
Usuario <|-- Fiscal
Usuario <|-- Administrador

Aluno "*" --> "1" Curso : cursa >
Aluno "*" --> "1" Filial : pertence a >
Fiscal "*" --> "*" Filial : atende >
Filial "1" *-- "*" Sala : possui >
Prova "*" --> "1" Curso : é de >
Alocacao "1" --> "1" Prova : aplica >
Alocacao "1" --> "1" Sala : ocorre em >
Alocacao "1" --> "*" Aluno : aloca >
Alocacao "1" --> "1" Fiscal : supervisionada por >
GerenciadorAlocacao ..> Alocacao : cria >
GerenciadorAlocacao ..> Sala : consulta >
GerenciadorAlocacao ..> Filial : consulta >

@enduml