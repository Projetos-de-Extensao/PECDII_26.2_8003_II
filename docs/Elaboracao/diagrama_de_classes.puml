@startuml AlocacaoProvas
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum TipoUsuario {
  ALUNO
  PROFESSOR
  ADMIN
}

enum StatusSala {
  LIVRE
  OCUPADA
  MANUTENCAO
}

enum StatusPresenca {
  PRESENTE
  AUSENTE
}

class Usuario {
  - id : int
  - nome : String
  - emailInstitucional : String
  - tipo : TipoUsuario
  + cadastrar()
  + autenticar()
}

class Aluno {
  - matricula : String
  + consultarAlocacao()
  + consultarResultado() : ResultadoTeste
  + escolherMateriaBonus(materia : Materia)
}

class Professor {
  - codigoFuncionario : String
  + consultarSalaDesignada()
  + registrarPresenca(aluno : Aluno, status : StatusPresenca)
}

class Administrador {
  + gerenciarSalas()
  + gerenciarProvas()
  + executarAlocacao()
  + lancarNota(aluno : Aluno, valor : float)
}

class Curso {
  - id : int
  - codigo : String
  - nome : String
}

class Materia {
  - id : int
  - codigo : String
  - nome : String
}

class Filial {
  - id : int
  - nome : String
  - endereco : String
  + listarSalasVazias(dataHora) : List<Sala>
}

class Sala {
  - id : int
  - numero : String
  - capacidade : int
  - status : StatusSala
  + estaDisponivel(dataHora) : bool
  + ocupar()
  + liberar()
}

class Prova {
  - id : int
  - disciplina : String
  - dataHora : DateTime
  - duracaoMin : int
  - notaMaxima : float
}

class Alocacao {
  - id : int
  - dataAlocacao : DateTime
  + validarCapacidade() : bool
  + adicionarAluno(aluno : Aluno)
  + definirProfessor(professor : Professor)
}

class GerenciadorAlocacao {
  + buscarSalasVazias(filial, prova) : List<Sala>
  + alocarAlunosPorCursoEFilial(prova)
  + alocarProfessor(sala, prova)
}

' --- Adendo: gerenciamento e atribuição de notas ---

class Presenca {
  - id : int
  - status : StatusPresenca
  - dataRegistro : DateTime
}

class ResultadoTeste {
  - id : int
  - nota : float
  - bonusAplicado : float
  - dataLancamento : DateTime
  + validarNota() : bool
}

class GerenciadorNotas {
  + lancarNota(aluno : Aluno, prova : Prova, valor : float) : ResultadoTeste
  + importarNotas(prova : Prova, arquivo)
  + aplicarBonus(resultado : ResultadoTeste)
  + exigirPresenca(aluno : Aluno, prova : Prova) : bool
}

Usuario <|-- Aluno
Usuario <|-- Professor
Usuario <|-- Administrador

Aluno "*" --> "1" Curso : cursa >
Aluno "*" --> "1" Filial : pertence a >
Aluno "*" --> "*" Materia : matriculado em >
Aluno "*" --> "0..1" Materia : bônus em >
Professor "*" --> "*" Filial : atende >
Filial "1" *-- "*" Sala : possui >
Curso "1" o-- "*" Materia : possui >
Prova "*" --> "1" Curso : é de >
Alocacao "1" --> "1" Prova : aplica >
Alocacao "1" --> "1" Sala : ocorre em >
Alocacao "1" --> "*" Aluno : aloca >
Alocacao "1" --> "1" Professor : supervisionada por >
GerenciadorAlocacao ..> Alocacao : cria >
GerenciadorAlocacao ..> Sala : consulta >
GerenciadorAlocacao ..> Filial : consulta >

Presenca "*" --> "1" Aluno : de >
Presenca "*" --> "1" Prova : em >
Presenca "*" --> "1" Professor : registrada por >
ResultadoTeste "*" --> "1" Aluno : pertence a >
ResultadoTeste "*" --> "1" Prova : referente a >
ResultadoTeste "*" --> "0..1" Materia : bônus aplicado em >
GerenciadorNotas ..> ResultadoTeste : cria >
GerenciadorNotas ..> Presenca : consulta >

@enduml
